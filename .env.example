# Modelo predeterminado: mejor calidad para equipos con 16 GB de RAM o mas.
LLM_MODEL=llama3.2:3b

# Alternativa liviana: descomentar esta linea y comentar la anterior.
# LLM_MODEL=llama3.2:1b

EMBEDDING_MODEL=qwen3-embedding:0.6b
DOCUMENT_START_PAGE=5
DOCUMENT_END_PAGE=107
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=6
MIN_SIMILARITY=0.25
MODEL_CONTEXT_TOKENS=4096
MODEL_OUTPUT_TOKENS=500
